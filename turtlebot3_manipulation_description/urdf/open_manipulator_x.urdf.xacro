        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/b21a26faa157_link4_up__col_FR12_H104_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/a213c70d364b_link5_down__col_Hex_socket_head_cap_screw_M2.5x0.45_x_8_3.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/403ce3549ac5_link5_down__col_WBH_M2_5X5_1_1.obj"/></geometry>

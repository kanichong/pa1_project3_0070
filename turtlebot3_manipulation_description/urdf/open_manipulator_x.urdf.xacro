      <collision>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/2256febe8211_arm_link2__col_0.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/cb457d710cfa_arm_link2__col_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/d4843461e743_arm_link2__col_2.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/ac3e7afa5e86_arm_link2__col_3.obj"/></geometry>
      </collision>
      <inertial>
        <origin xyz="1.0308393e-02 3.7743363e-04 1.0170197e-01" />
        <mass value="1.3850917e-01" />
        <inertia ixx="3.3055381e-04" ixy="-9.7940978e-08" ixz="-3.8505711e-05"
                 iyy="3.4290447e-04" iyz="-1.5717516e-06"
                 izz="6.0346498e-05" />
      </inertial>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <origin xyz="0.024 0 0.128" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1" lower="${-pi*0.3}" upper="${pi*0.44}"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link4">
      <visual>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/dc49969539e2_arm_link3__motor.obj"/></geometry>
        <material name="onshape_arm_0"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/4a2cf731943d_arm_link3__frame.obj"/></geometry>
        <material name="onshape_arm_1"><color rgba="0.62 0.66 0.7 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/92a4f59a9842_arm_link3__col_0.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/505813ecee13_arm_link3__col_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/9db965e8aad0_arm_link3__col_2.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0.0189 0" rpy="0.21328964 0.419647329 0.488587164"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/af624245d967_arm_link3__col_3.obj"/></geometry>
      </collision>
      <inertial>
        <origin xyz="9.0909590e-02 3.8929816e-04 2.2413279e-04" />
        <mass value="1.3274562e-01" />
        <inertia ixx="3.0654178e-05" ixy="-1.2764155e-06" ixz="-2.6874417e-07"
                 iyy="2.4230292e-04" iyz="1.1559550e-08"
                 izz="2.5155057e-04" />
      </inertial>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <origin xyz="0.124 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1" lower="${-pi*0.57}" upper="${pi*0.65}"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link5">
      <visual>
        <origin xyz="0 -0.0191 0" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/ad7dd3a70b01_link4_up__frame.obj"/></geometry>

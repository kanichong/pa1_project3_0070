      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/611cfec32b7d_link5_down__col_WBH_M2_5X5_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>

<?xml version="1.0"?>
<!-- OpenMANIPULATOR-X kinematics with the team Onshape "Manipulator" arm meshes.
  Source: TurtleNinja_CAD_J5_SimPractice_20261021/robot.urdf (sha256 58fa6587ad6042a3...),
  Onshape document bc072e31ba55ae870d6e3bba microversion f70246. The CAD wrist roll motor (arm_joint5,
  XM430) is not on the real arm: it is removed and the gripper unit is moved so its motor sits where
  the J5 motor sat in the bracket. The two wrist-camera bracket screws on top of the gripper motor
  are removed.
  Frames follow the ROBOTIS OpenMANIPULATOR-X convention used by the OpenCR firmware and this
  repository: q = 0 is the motor zero pose, joint1 about +z, joint2..4 about +y.
  The CAD assembly pose corresponds to joint1..4 =
  90.00, 9.33, -36.14, 73.07 deg.
  Gripper fingers: q = 0 is the real gripper zero (motor tick 3549, nearly closed), + opens,
  range -0.003 .. 0.020 m (team -0.003..0.0175; on 2026-11-26 5.6 mm of rail was left at 0.0164, and 0.020 shook at the end, so open is 0.019).
  No wrist camera on the real arm. Inertials are the official OpenMANIPULATOR-X values.
  Generated by gen_arm.py, then drop_j5.py and add_gripper_linkage.py. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="open_manipulator_x" params="prefix gripper_linkage:=true">
    <link name="${prefix}link1">
      <visual>
        <origin xyz="0.012 0 0.036" rpy="0 0 2.013796647"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/5175ee609337_arm_base_link__motor.obj"/></geometry>
        <material name="onshape_arm_0"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <collision>
        <origin xyz="0.012 0 0.036" rpy="0 0 2.013796647"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/4d5847efa33c_arm_base_link__col_0.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.012 0 0.036" rpy="0 0 2.013796647"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/2b8fa383edac_arm_base_link__col_1.obj"/></geometry>
      </collision>
      <inertial>
        <origin xyz="3.0876154e-04 0.0000000e+00 -1.2176461e-04" />
        <mass value="7.9119962e-02" />
        <inertia ixx="1.2505234e-05" ixy="0.0" ixz="-1.7855208e-07"
                 iyy="2.1898364e-05" iyz="0.0"
                 izz="1.9267361e-05" />
      </inertial>
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <origin xyz="0.012 0 0.017" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit velocity="4.8" effort="1" lower="${-pi*0.9}" upper="${pi*0.9}"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link2">
      <visual>
        <origin xyz="0 0 0.019" rpy="0 0 0.44300032"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/dc809cd56e9a_arm_link1__frame.obj"/></geometry>
        <material name="onshape_arm_1"><color rgba="0.62 0.66 0.7 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.019" rpy="0 0 0.44300032"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/ae1ccc0ff0af_arm_link1__motor.obj"/></geometry>
        <material name="onshape_arm_0"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.019" rpy="0 0 0.44300032"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/c7e4e1dc94aa_arm_link1__col_0.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0.019" rpy="0 0 0.44300032"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/c3e4df59c7dd_arm_link1__col_1.obj"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-3.0184870e-04 5.4043684e-04 ${0.018 + 2.9433464e-02}" />
        <mass value="9.8406837e-02" />
        <inertia ixx="3.4543422e-05" ixy="-1.6031095e-08" ixz="-3.8375155e-07"
                 iyy="3.2689329e-05" iyz="2.8511935e-08"
                 izz="1.8850320e-05" />
      </inertial>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <origin xyz="0 0 0.0595" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit velocity="4.8" effort="1" lower="${-pi*0.57}" upper="${pi*0.5}"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="${prefix}link3">
      <visual>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/0021a7855b1f_arm_link2__frame.obj"/></geometry>
        <material name="onshape_arm_1"><color rgba="0.62 0.66 0.7 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 -0.0191 0" rpy="-0.070343124 -0.147070287 0.448184482"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/7e1e8c42d5d1_arm_link2__motor.obj"/></geometry>
        <material name="onshape_arm_0"><color rgba="0.15 0.15 0.17 1"/></material>

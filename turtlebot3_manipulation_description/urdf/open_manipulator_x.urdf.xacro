        </collision>
      </xacro:unless>
    </link>

    <!-- crank + two rods: angles come from gripper_linkage_state.py (gripper_left_joint -> crank / rods) -->
    <xacro:if value="${gripper_linkage}">
      <joint name="${prefix}gripper_crank_joint" type="revolute">
        <parent link="${prefix}link5"/>
        <child link="${prefix}gripper_crank_link"/>
        <origin xyz="0.062596287 -0.000099999 -0.000681653" rpy="1.454249495 -0.531724552 -0.762859472"/>
        <axis xyz="0.6175023401994564 -0.2929746130211112 -0.7299703665035485"/>
        <limit lower="-1.4597546605726492" upper="0.5487568609631227" effort="0" velocity="1000"/>
      </joint>
      <link name="${prefix}gripper_crank_link">
        <visual><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/gripper_linkage/gripper_drive_crank.obj"/></geometry><material name="gripper_drive_crank"><color rgba="0.62 0.66 0.70 1"/></material></visual>
        <visual><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/gripper_linkage/gripper_drive_pin.obj"/></geometry><material name="gripper_drive_pin"><color rgba="0.62 0.66 0.70 1"/></material></visual>
        <visual><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/gripper_linkage/gripper_drive_nut.obj"/></geometry><material name="gripper_drive_nut"><color rgba="0.62 0.66 0.70 1"/></material></visual>
        <collision><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/gripper_linkage/gripper_drive_crank_collision.obj"/></geometry></collision>
        <collision><geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/gripper_linkage/gripper_drive_nut_collision.obj"/></geometry></collision>
        <inertial><mass value="0.001"/><inertia ixx="1e-08" ixy="0" ixz="0" iyy="1e-08" iyz="0" izz="1e-08"/></inertial>
      </link>
      <joint name="${prefix}gripper_left_rod_joint" type="revolute">
        <parent link="${prefix}gripper_crank_link"/>
        <child link="${prefix}gripper_left_rod_link"/>
        <origin xyz="0.0166411304345537 0.002862983975471935 0.001968785899468133" rpy="-0.6200899640021704 0.7436650506083438 0.8801201391939419"/>
        <axis xyz="0.6175023401994564 -0.2929746130211112 -0.7299703665035485"/>
        <limit lower="-0.3736772420719872" upper="1.459455471919926" effort="0" velocity="1000"/>
      </joint>

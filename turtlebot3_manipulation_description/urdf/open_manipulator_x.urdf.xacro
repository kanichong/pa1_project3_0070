                 izz="9.3127351e-05" />
      </inertial>
      <xacro:unless value="${gripper_linkage}">
        <visual>
          <origin xyz="0.062596287 -0.000100000 -0.000681651" rpy="-0.42113309 -0.711199476 0.601424975"/>
          <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/33c84fa1b3ca_gripper_crank__frame.obj"/></geometry>
          <material name="onshape_arm_1"><color rgba="0.62 0.66 0.7 1"/></material>
        </visual>
        <visual>
          <origin xyz="0.062596287 -0.000100000 -0.000681651" rpy="-0.42113309 -0.711199476 0.601424975"/>
          <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/730b781d4e6d_linkage_rods_CAD_pose.obj"/></geometry>
          <material name="onshape_arm_5"><color rgba="0.95 0.8 0.15 1"/></material>
        </visual>
        <visual>
          <origin xyz="0.068471527 -0.009819875 -0.012171019" rpy="-0.42113309 -0.711199476 0.601424975"/>
          <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/e7d6dee01bb6_gripper_nut__frame.obj"/></geometry>

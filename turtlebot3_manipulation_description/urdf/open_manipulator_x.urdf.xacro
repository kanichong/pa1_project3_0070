        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/e0b775a579ae_link5_down__col_DC12_A01_SPACER_RING_2_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/b5e8b20ff4be_link5_down__col_WBH_M2_5X10_2_1.obj"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/02e497356ade_link5_down__col_IRB-A02_OPEN_1.obj"/></geometry>

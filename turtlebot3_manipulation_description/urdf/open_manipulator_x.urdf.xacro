      </collision>
      <collision>
        <origin xyz="0.018729564 -0.000100000 0.011796755" rpy="-0.42113309 -0.711199476 0.601424975"/>
        <geometry><mesh filename="package://turtlebot3_manipulation_description/meshes/onshape_arm/4ee016f6b685_link5_down__col_DC12_STD_1_1.obj"/></geometry>
      </collision>
